# Local Ollama configuration for server-side RAG/search.
# The current Montgomery County calls-for-service dataset is public, so local
# Ollama indexing and search may cover the full fetched dataset.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
RAG_INDEX_SCOPE=all_public_records
RAG_DATABASE_PATH=data/rag/rag.sqlite

# Vehicle-risk forecast workflow.
# SODA3 uses this token when present; the script falls back to public SODA2 for
# local prototyping if it is omitted.
SOCRATA_APP_TOKEN=

# Optional historical weather token for future expansion.
NOAA_CDO_TOKEN=

# National Weather Service asks clients to identify themselves.
NWS_USER_AGENT=mcpd-call-for-service-dashboard/vehicle-risk local-analysis
